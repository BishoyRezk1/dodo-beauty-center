# ==== Database ====
DATABASE_URL="postgresql://user:password@localhost:5432/dodo_beauty?schema=public"

# ==== NextAuth ====
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# ==== Admin bootstrap (used only by prisma/seed.ts) ====
ADMIN_EMAIL="admin@dodobeauty.com"
ADMIN_PASSWORD="ChangeMe123!"

# ==== Image storage (choose one) ====
# Cloudinary
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# Supabase Storage
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_BUCKET="payment-screenshots"

# ==== WhatsApp Business Cloud API (optional — leave blank to use wa.me links instead) ====
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_SHOP_NUMBER="201XXXXXXXXX"

# ==== Google Maps ====
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""
