generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AdminRole {
  OWNER
  STAFF
}

enum BookingStatus {
  PENDING
  CONFIRMED
  REJECTED
  CANCELLED
  COMPLETED
}

enum FeeType {
  FIXED
  PERCENT
}

model AdminUser {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         AdminRole @default(OWNER)
  createdAt    DateTime  @default(now())
}

model Customer {
  id                String    @id @default(cuid())
  name              String
  phone             String    @unique
  bookings          Booking[]
  conversation      Conversation?
  pushSubscriptions PushSubscription[]
  loyaltyTransactions LoyaltyTransaction[]
  totalPaid         Decimal   @default(0) @db.Decimal(10, 2)
  lastTransactionAt DateTime?
  notes             String?
  isBlocked         Boolean   @default(false)
  passwordHash      String?
  email             String?
  avatarUrl         String?
  birthDate         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model Service {
  staffServices StaffService[]
  id            String    @id @default(cuid())
  name          String
  nameEn        String?
  slug          String    @unique
  category      String    @default("general")
  description   String?
  imageUrl      String?
  price         Decimal   @db.Decimal(10, 2)
  discountPrice Decimal?  @db.Decimal(10, 2)
  durationMin   Int       @default(60)
  bufferMin     Int       @default(0)
  status        String    @default("AVAILABLE")
  isActive      Boolean   @default(true)
  sortOrder     Int       @default(0)
  bookings      Booking[]
  offers        Offer[]
  coupons       Coupon[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Offer {
  id        String   @id @default(cuid())
  title     String
  details   String?
  imageUrl  String?
  oldPrice  Decimal  @db.Decimal(10, 2)
  newPrice  Decimal  @db.Decimal(10, 2)
  startDate DateTime
  endDate   DateTime
  isActive  Boolean  @default(true)
  archivedAt DateTime?
  serviceId String?
  service   Service? @relation(fields: [serviceId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([serviceId])
}

model Booking {
  id              String        @id @default(cuid())
  bookingNumber   String        @unique
  customerId      String
  customer        Customer      @relation(fields: [customerId], references: [id])
  serviceId       String
  service         Service       @relation(fields: [serviceId], references: [id])
  date            DateTime
  startTime       String
  endTime         String
  notes           String?
  feeAmount       Decimal       @db.Decimal(10, 2)
  status          BookingStatus @default(PENDING)
  couponCode      String?
  discountPercent Int?
  reminder24Sent  Boolean       @default(false)
  reminder2Sent   Boolean       @default(false)
  payment         Payment?
  staffId         String?
  staff           Staff?        @relation(fields: [staffId], references: [id])
  review          Review?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([date, startTime])
  @@index([status])
}

model Payment {
  id            String    @id @default(cuid())
  bookingId     String    @unique
  booking       Booking   @relation(fields: [bookingId], references: [id])
  amount        Decimal   @db.Decimal(10, 2)
  method        String    @default("VODAFONE_CASH")
  screenshotUrl String
  verified      Boolean   @default(false)
  verifiedAt    DateTime?
  createdAt     DateTime  @default(now())
}

model WorkingHours {
  id         String  @id @default(cuid())
  dayOfWeek  Int // 0 = Sunday ... 6 = Saturday
  isOpen     Boolean @default(true)
  startTime  String  @default("10:00")
  endTime    String  @default("22:00")
  breakStart String?
  breakEnd   String?

  @@unique([dayOfWeek])
}

model ClosedDate {
  id     String   @id @default(cuid())
  date   DateTime @unique
  reason String?
}

model Notification {
  id        String   @id @default(cuid())
  title     String
  body      String
  type      String   @default("BOOKING")
  isRead    Boolean  @default(false)
  bookingId String?
  createdAt DateTime @default(now())
}

model Setting {
  id    String @id @default(cuid())
  key   String @unique
  value String @db.Text
}

model GalleryItem {
  id        String   @id @default(cuid())
  title     String
  category  String // "hair" | "coloring" | "makeup" | "skincare" | "before_after"
  imageUrl  String
  beforeUrl String? // optional "before" image for before/after pairs
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

model Review {
  id           String   @id @default(cuid())
  bookingId    String?  @unique
  booking      Booking? @relation(fields: [bookingId], references: [id])
  facebookId   String?  @unique
  customerName String
  rating       Int // 1-5
  comment      String?
  isApproved   Boolean  @default(false)
  createdAt    DateTime @default(now())
  imageUrl     String?
  isFeatured   Boolean  @default(false)
}

model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
}

model PageView {
  id        String   @id @default(cuid())
  path      String
  device    String?
  browser   String?
  os        String?
  source    String?
  country   String?
  city      String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model Coupon {
  id              String    @id @default(cuid())
  code            String    @unique
  discountPercent Int
  maxUses         Int?
  usedCount       Int       @default(0)
  expiresAt       DateTime?
  isActive        Boolean   @default(true)
  serviceId       String?
  service         Service?  @relation(fields: [serviceId], references: [id])
  createdAt       DateTime  @default(now())
}

model SpecialWorkingHours {
  id         String   @id @default(cuid())
  date       DateTime @unique
  isOpen     Boolean  @default(true)
  startTime  String   @default("10:00")
  endTime    String   @default("22:00")
  breakStart String?
  breakEnd   String?
  reason     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([date])
}

model Conversation {
  id                 String    @id @default(cuid())
  customerId         String    @unique
  customer           Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  messages           Message[]
  lastMessageAt      DateTime?
  lastMessagePreview String?
  customerUnread     Int       @default(0)
  adminUnread        Int       @default(0)
  customerLastSeenAt DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([lastMessageAt])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         String // CUSTOMER | ADMIN
  kind           String       @default("TEXT") // TEXT | IMAGE | SERVICE_CARD | OFFER_CARD | BOOKING_CARD
  body           String?
  imageUrl       String?
  serviceId      String?
  bookingId      String?
  replyToId      String?
  replyTo        Message?     @relation("MessageReply", fields: [replyToId], references: [id], onDelete: SetNull)
  replies        Message[]    @relation("MessageReply")
  deliveredAt    DateTime?
  readAt         DateTime?
  deletedAt      DateTime?
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

model QuickReply {
  id        String   @id @default(cuid())
  title     String
  body      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

model LoyaltyTransaction {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  points     Int
  type       String // BOOKING | REVIEW | REDEEM | MANUAL
  reason     String?
  refKey     String?  @unique
  createdAt  DateTime @default(now())

  @@index([customerId, createdAt])
}

model CustomerPushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
}

model PushOffer {
  id         String    @id @default(cuid())
  title      String
  body       String
  url        String    @default("/offers")
  status     String    @default("active")
  timesSent  Int       @default(0)
  lastSentAt DateTime?
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model FinanceEntry {
  id          String   @id @default(cuid())
  type        String
  amount      Decimal  @db.Decimal(10, 2)
  category    String
  method      String
  entryDate   DateTime
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([entryDate])
  @@index([type])
}

model FinanceAccount {
  id                String        @id @default(cuid())
  code              String        @unique
  name              String
  isActive          Boolean       @default(true)
  openingBalance    Decimal?      @db.Decimal(14, 2)
  openingDate       DateTime?
  openingApprovedAt DateTime?
  createdAt         DateTime      @default(now())
  entries           LedgerEntry[]
}

model LedgerEntry {
  id             String         @id @default(cuid())
  entryNo        BigInt         @unique @default(autoincrement())
  type           String
  category       String
  accountId      String
  account        FinanceAccount @relation(fields: [accountId], references: [id])
  amount         Decimal        @db.Decimal(14, 2)
  entryDate      DateTime
  description    String?
  source         String         @default("MANUAL")
  legacyId       String?        @unique
  idempotencyKey String?        @unique
  createdById    String?
  status         String         @default("POSTED")
  voidReason     String?
  voidedAt       DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([entryDate])
  @@index([accountId])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actorName String?
  action    String
  entity    String
  entityId  String?
  before    Json?
  after     Json?
  reason    String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
}

model Invoice {
  id             String           @id @default(cuid())
  invoiceNo      BigInt           @unique @default(autoincrement())
  customerId     String?
  bookingId      String?
  invoiceDate    DateTime         @default(now())
  subtotal       Decimal          @default(0) @db.Decimal(14, 2)
  discountTotal  Decimal          @default(0) @db.Decimal(14, 2)
  total          Decimal          @default(0) @db.Decimal(14, 2)
  paidTotal      Decimal          @default(0) @db.Decimal(14, 2)
  status         String           @default("ISSUED")
  notes          String?
  idempotencyKey String?          @unique
  createdById    String?
  cancelReason   String?
  cancelledAt    DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  items          InvoiceItem[]
  payments       InvoicePayment[]
  refunds        InvoiceRefund[]

  @@index([invoiceDate])
  @@index([customerId])
}

model InvoiceItem {
  staffId String?
  staff   Staff?  @relation(fields: [staffId], references: [id])
  id          String   @id @default(cuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id])
  serviceId   String?
  description String
  quantity    Int      @default(1)
  unitPrice   Decimal  @db.Decimal(14, 2)
  discount    Decimal  @default(0) @db.Decimal(14, 2)
  lineTotal   Decimal  @db.Decimal(14, 2)
  createdAt   DateTime @default(now())

  @@index([invoiceId])
}

model InvoicePayment {
  id               String    @id @default(cuid())
  invoiceId        String
  invoice          Invoice   @relation(fields: [invoiceId], references: [id])
  accountId        String
  amount           Decimal   @db.Decimal(14, 2)
  paidAt           DateTime  @default(now())
  kind             String    @default("PAYMENT")
  bookingPaymentId String?   @unique
  idempotencyKey   String?   @unique
  createdById      String?
  status           String    @default("POSTED")
  voidReason       String?
  voidedAt         DateTime?
  createdAt        DateTime  @default(now())

  @@index([invoiceId])
  @@index([paidAt])
}

model InvoiceRefund {
  id             String   @id @default(cuid())
  invoiceId      String
  invoice        Invoice  @relation(fields: [invoiceId], references: [id])
  accountId      String
  amount         Decimal  @db.Decimal(14, 2)
  reason         String
  refundDate     DateTime @default(now())
  idempotencyKey String?  @unique
  createdById    String?
  createdAt      DateTime @default(now())

  @@index([invoiceId])
}

model AccountTransfer {
  id             String    @id @default(cuid())
  transferNo     BigInt    @unique @default(autoincrement())
  fromAccountId  String
  toAccountId    String
  amount         Decimal   @db.Decimal(14, 2)
  transferDate   DateTime  @default(now())
  note           String?
  idempotencyKey String?   @unique
  createdById    String?
  status         String    @default("POSTED")
  voidReason     String?
  voidedAt       DateTime?
  createdAt      DateTime  @default(now())
}

model AccountCount {
  id            String   @id @default(cuid())
  accountId     String
  bookAmount    Decimal  @db.Decimal(14, 2)
  countedAmount Decimal  @db.Decimal(14, 2)
  difference    Decimal  @db.Decimal(14, 2)
  note          String?
  createdById   String?
  countedAt     DateTime @default(now())
  settledAt     DateTime?
  settleNote    String?

  @@index([accountId, countedAt])
}

model MonthlyArchive {
  id      String   @id @default(cuid())
  month   String   @unique
  data    Json
  locked  Boolean  @default(false)
  savedAt DateTime @default(now())
}

model ShopCategory {
  id        String        @id @default(cuid())
  name      String
  slug      String        @unique
  imageUrl  String?
  sortOrder Int           @default(0)
  isActive  Boolean       @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  products  ShopProduct[]
}

model ShopProduct {
  id           String          @id @default(cuid())
  categoryId   String?
  category     ShopCategory?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  name         String
  slug         String          @unique
  sku          String?         @unique
  description  String?
  imageUrl     String?
  images       String[]        @default([])
  price        Decimal         @db.Decimal(10, 2)
  comparePrice Decimal?        @db.Decimal(10, 2)
  stock        Int             @default(0)
  lowStockAt   Int             @default(3)
  isActive     Boolean         @default(true)
  isArchived   Boolean         @default(false)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  orderItems   ShopOrderItem[]

  @@index([categoryId])
  @@index([isActive, isArchived])
  @@index([createdAt])
}

model ShopOrder {
  id             String          @id @default(cuid())
  orderNo        BigInt          @unique @default(autoincrement())
  customerId     String?
  customerName   String
  phone          String
  whatsapp       String
  governorate    String
  city           String
  address        String
  notes          String?
  paymentMethod  String
  paymentStatus  String          @default("UNPAID")
  status         String          @default("AWAITING_CONFIRMATION")
  transferRef    String?
  receiptUrl     String?
  subtotal       Decimal         @db.Decimal(12, 2)
  discountTotal  Decimal         @default(0) @db.Decimal(12, 2)
  deliveryFee    Decimal         @default(0) @db.Decimal(12, 2)
  total          Decimal         @db.Decimal(12, 2)
  adminNotes     String?
  stockRestored  Boolean         @default(false)
  idempotencyKey String?         @unique
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  items          ShopOrderItem[]

  @@index([status])
  @@index([createdAt])
  @@index([phone])
}

model ShopOrderItem {
  id           String       @id @default(cuid())
  orderId      String
  order        ShopOrder    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String?
  product      ShopProduct? @relation(fields: [productId], references: [id], onDelete: SetNull)
  name         String
  sku          String?
  imageUrl     String?
  unitPrice    Decimal      @db.Decimal(10, 2)
  comparePrice Decimal?     @db.Decimal(10, 2)
  quantity     Int
  lineTotal    Decimal      @db.Decimal(12, 2)

  @@index([orderId])
  @@index([productId])
}

model Staff {
  id              String         @id @default(cuid())
  name            String
  phone           String?
  isActive        Boolean        @default(true)
  commissionType  String         @default("PERCENT")
  commissionValue Decimal        @default(0) @db.Decimal(10, 2)
  notes           String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @default(now()) @updatedAt
  services        StaffService[]
  payouts         StaffPayout[]
  bookings        Booking[]
  invoiceItems    InvoiceItem[]
}

model StaffService {
  staffId   String
  serviceId String
  staff     Staff   @relation(fields: [staffId], references: [id], onDelete: Cascade)
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([staffId, serviceId])
}

model StaffPayout {
  id             String   @id @default(cuid())
  staffId        String
  staff          Staff    @relation(fields: [staffId], references: [id])
  amount         Decimal  @db.Decimal(14, 2)
  accountId      String
  ledgerEntryId  String?
  note           String?
  paidAt         DateTime @default(now())
  createdById    String?
  idempotencyKey String?  @unique
  createdAt      DateTime @default(now())

  @@index([staffId])
}
